# Copy this file to deploy/.env and set the values.

# The public host name of the site. Caddy gets a certificate for it.
SITE_ADDRESS=reviews.example.com

# The key that encrypts the PocketBase settings in the database. It must have
# 32 characters. Make one with: openssl rand -hex 16
# The backups do not have this key. Keep a copy in a different place.
PB_ENCRYPTION_KEY=change-me

# The memory of the app container, and the limit of the Go runtime below it.
# The defaults are for a server with 1 GB.
# APP_MEMORY_LIMIT=768m
# APP_GOMEMLIMIT=600MiB

# Settings of the app. AGENTS.md lists them.
# REVIEWS_PLACES_URL=https://photon.komoot.io
# REVIEWS_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
