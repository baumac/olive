# Caddy gets a TLS certificate for SITE_ADDRESS and sends each request to the app.
{$SITE_ADDRESS} {
	encode zstd gzip
	# The limit is above the 10 MiB of the app. The app then gives its own 413.
	request_body {
		max_size 11MB
	}
	reverse_proxy app:8090 {
		# Set the trusted proxy header of the PocketBase settings to X-Real-IP.
		header_up X-Real-IP {remote_host}
	}
}
